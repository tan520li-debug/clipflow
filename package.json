{
  "name": "clipflow",
  "private": true,
  "version": "0.1.0",
  "description": "面向抖音、小红书、TikTok、Instagram Reels 与 Facebook Reels 的中英双语短视频剪辑工作台",
  "author": "合肥拓路人信息科技有限公司 <tan520li@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.domain.json",
    "lint": "biome lint src/domain src/contracts src/server/gemini.ts src/server/middleware src/server/main.ts src/client/api scripts",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.domain.json && biome lint src/domain src/contracts src/server/gemini.ts src/server/middleware src/server/main.ts src/client/api scripts && vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.12.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
