# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_TOKEN: Required token sent via request header "x-clipflow-token" for all /api/* routes (except /api/health).
ADMIN_ACCESS_TOKEN="CHANGE_ME_ADMIN_TOKEN"

# GEMINI_TEXT_MODEL / GEMINI_TTS_MODEL / GEMINI_TRANSCRIBE_MODEL: Optional primary model overrides.
# When unset or unavailable, server automatically falls back to public stable Gemini models.
GEMINI_TEXT_MODEL="gemini-3.1-flash-lite"
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"

# GEMINI_VIDEO_MODEL: Optional Veo model for the talking-video button.
# GEMINI_VIDEO_MODEL="veo-3.1-generate-preview"

# PORT: HTTP port for the studio. Defaults to 3000.
# PORT="3000"

# CLIPFLOW_TMP_DIR: Optional absolute directory for transcode scratch files.
# Defaults to data/tmp inside this repo. Relative values are ignored.
# CLIPFLOW_TMP_DIR="D:/clipflow/clipflow/data/tmp"

# CLIPFLOW_JOB_DEADLINE_MS: Optional cap for one background job, in milliseconds.
# Defaults to 15 minutes. A stuck job is marked failed so the next one can run.
# CLIPFLOW_JOB_DEADLINE_MS="900000"

# CLIPFLOW_JOB_QUEUE_MAX: How many jobs may be waiting or running at once. Defaults to 8.
# CLIPFLOW_JOB_QUEUE_MAX="8"

# FFMPEG_PATH: Optional absolute path to ffmpeg. Used when it is not on PATH.
# FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"

# When HTTPS_PROXY or HTTP_PROXY is set, the server turns on Node's env proxy
# so Gemini requests leave through that proxy.

